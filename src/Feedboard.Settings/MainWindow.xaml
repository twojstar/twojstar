<Window
    x:Class="Feedboard.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Feedboard settings">
  <Grid Padding="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <StackPanel>
      <TextBlock Text="Feedboard" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Text="Feeds, OPML and local widget settings" Opacity="0.7" />
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox x:Name="FeedUrlBox" PlaceholderText="https://example.com/feed.xml" />
      <Button Grid.Column="1" Content="Add feed" Click="AddFeed_Click" />
    </Grid>
    <ListView x:Name="FeedsList" Grid.Row="2" ItemsSource="{x:Bind Feeds}">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:FeedRow" xmlns:local="using:Feedboard.Settings">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="4,8">
            <ToggleSwitch IsOn="{x:Bind Enabled, Mode=OneWay}" Toggled="Enabled_Toggled" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind Url}" Opacity="0.65" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2" Content="Remove" Click="RemoveFeed_Click" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
      <Button Content="Import OPML" Click="ImportOpml_Click" />
      <Button Content="Export OPML" Click="ExportOpml_Click" />
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="8,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
